# GitHub ignore list for Abetris Auto Switcher PRO plugin
# Exclude build artifacts, screenshots, and temporary files

# IPK packages (built binaries)
*.ipk

# DEB packages (built binaries)
*.deb

# Graphify generated cache
graphify-out/

# Screenshots / OSD images
*.png

# IPK build directory
/dist/
/build/

# Python cache
__pycache__/
*.pyc
*.pyo

# OS files
.DS_Store
Thumbs.db

# Backups
abetris-backup/

# Temporary files
*.tmp
*.tmp*
*.swp
*~