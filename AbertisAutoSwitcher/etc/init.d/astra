#!/bin/sh
### BEGIN INIT INFO
# Provides:          astra
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: astra-sm streaming (Abertis T2-MI de-encapsulation)
### END INIT INFO

# Init script for astra-sm.  It is the same service as /etc/init.d/astra-sm;
# this name is the one used by the "astra" package layout.

DAEMON=/usr/bin/astra
CONF=/etc/astra/astra.conf
PIDFILE=/var/run/astra.pid
LOGFILE=/tmp/astra.log

is_running() {
	pidof astra >/dev/null 2>&1
}

case "$1" in
	start)
		if is_running; then
			echo "astra already running"
			exit 0
		fi
		[ -x "$DAEMON" ] || { echo "astra binary missing"; exit 1; }
		[ -f "$CONF" ] || { echo "astra.conf missing"; exit 1; }
		rm -f "$PIDFILE"
		nohup "$DAEMON" --pid "$PIDFILE" --log "$LOGFILE" "$CONF" >/dev/null 2>&1 &
		sleep 1
		if is_running; then
			echo "astra started"
			exit 0
		fi
		echo "astra failed to start"
		exit 1
		;;
	stop)
		if [ -f "$PIDFILE" ]; then
			kill "$(cat "$PIDFILE")" 2>/dev/null
		fi
		for p in $(pidof astra); do
			kill "$p" 2>/dev/null
		done
		sleep 1
		rm -f "$PIDFILE"
		echo "astra stopped"
		;;
	restart)
		"$0" stop
		sleep 1
		"$0" start
		;;
	status)
		if is_running; then
			echo "astra running"
		else
			echo "astra not running"
		fi
		;;
	*)
		echo "usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
exit 0
