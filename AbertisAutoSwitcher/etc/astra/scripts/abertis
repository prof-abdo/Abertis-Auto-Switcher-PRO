#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""Abertis T2-MI de-encapsulator (aarch64-friendly Python replacement).

Extracts the MPEG-TS packets for a given PID from stdin and writes their
payload to stdout. Drop-in replacement for the armhf 'abertis' binary that
does not run on 64-bit DreamOS.

Usage:  abertis <PID>
"""
import sys


def _streams():
    try:
        return sys.stdin.buffer, sys.stdout.buffer
    except AttributeError:
        return sys.stdin, sys.stdout


def _b(x):
    """Return integer value of a byte, py2/py3 safe."""
    if isinstance(x, int):
        return x
    return ord(x)


def main():
    if len(sys.argv) < 2:
        sys.stderr.write("usage: abertis <PID>\n")
        return 2
    try:
        pid = int(sys.argv[1])
    except ValueError:
        sys.stderr.write("invalid PID: %s\n" % sys.argv[1])
        return 2

    inp, out = _streams()
    SYNC = 0x47
    while True:
        chunk = inp.read(188)
        if not chunk:
            break
        if len(chunk) < 188:
            break
        buf = chunk
        if _b(buf[0]) != SYNC:
            idx = buf.find(chr(SYNC) if not isinstance(buf[0], int) else bytes([SYNC]))
            # simpler: try both
            try:
                idx = buf.find(b"\x47")
            except Exception:
                idx = -1
            if idx < 0:
                continue
            # skip this misaligned chunk
            continue
        tspid = ((_b(buf[1]) & 0x1F) << 8) | _b(buf[2])
        if tspid != pid:
            continue
        afc = _b(buf[3]) & 0x30
        payload = b""
        if afc == 0x10:
            payload = buf[4:]
        elif afc == 0x30:
            afl = _b(buf[4])
            payload = buf[5 + afl:]
        # 0x20 adaptation only, 0x00 no payload -> empty
        if payload:
            try:
                out.write(payload)
                out.flush()
            except Exception:
                pass
    try:
        out.flush()
    except Exception:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
